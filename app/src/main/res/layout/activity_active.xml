<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/bg"
    android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:orientation="vertical" android:padding="24dp"
    android:gravity="center_horizontal"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:text="TIMER BERJALAN" android:textSize="18sp"
        android:textColor="@color/text"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <FrameLayout android:layout_width="280dp" android:layout_height="280dp"
        android:layout_marginTop="8dp">
        <ProgressBar android:id="@+id/ringActive" style="?android:attr/progressBarStyleHorizontal"
            android:progressDrawable="@drawable/ring" android:max="100" android:progress="100"
            android:layout_width="match_parent" android:layout_height="match_parent" />
        <LinearLayout android:orientation="vertical" android:gravity="center"
            android:layout_width="match_parent" android:layout_height="match_parent">
            <TextView android:id="@+id/tvTime" android:text="--:--" android:textSize="56sp"
                android:textColor="@color/text"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/tvState" android:text="berjalan" android:textColor="@color/ok"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
    </FrameLayout>
    <TextView android:id="@+id/tvInfo" android:textColor="@color/text2"
        android:gravity="center" android:layout_marginTop="8dp"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/tvWarn" android:textColor="@color/warn" android:visibility="gone"
        android:gravity="center"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Button android:id="@+id/btnPause" android:text="Pause / Resume"
        android:layout_marginTop="12dp"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Button android:id="@+id/btnCancel" android:text="Batalkan (PIN)"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
</LinearLayout>
</ScrollView>
